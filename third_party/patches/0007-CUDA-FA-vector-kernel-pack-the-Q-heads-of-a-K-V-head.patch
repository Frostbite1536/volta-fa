+    const int gqa_ratio  = ne02 / ne12; // With grouped query attention there are > 1 Q matrices per K, V matrix.
+    const int iter_z_gqa = (gqa_ratio + ncols2 - 1) / ncols2;
+    const int sequence   = blockIdx.z / (iter_z_gqa*ne12);
+    const int z_KV       = (blockIdx.z - sequence*iter_z_gqa*ne12) / iter_z_gqa;
+    const int zt_gqa     = blockIdx.z - sequence*iter_z_gqa*ne12 - z_KV*iter_z_gqa;
+    const int head       = z_KV*gqa_ratio + zt_gqa*ncols2; // First Q head of the block.
     Q += nb03*sequence + nb02* head              + nb01*ic0;
-    K += nb13*sequence + nb12*(head / gqa_ratio);
-    V += nb23*sequence + nb22*(head / gqa_ratio);
+    K += nb13*sequence + nb12*z_KV;
