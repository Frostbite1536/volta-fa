index 000000000..2e292f4ce
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-volta.cuh
@@ -0,0 +1,11 @@
+#pragma once
+
+#include "common.cuh"
+
+// Quantized weights x F32 activations for 2..16 tokens on Volta with FP16 tensor cores (mma.sync.m8n8k4).
+// MMVQ redoes the dequantization per column and MMQ uses dp4a on Volta (no int8 tensor cores), so both
+// fall well below the weight-read rate at these batch sizes; this kernel streams the weights once in their
+// GGUF layout and decodes them into FP16 tensor-core fragments.
+bool ggml_cuda_should_use_mmq_volta(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, int cc);
+
+void ggml_cuda_mul_mat_q_volta(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst);
