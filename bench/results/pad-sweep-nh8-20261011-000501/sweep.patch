+template <ggml_type type, int qk, int qr, dequantize_kernel_t dequantize_kernel, typename dst_t>
+static void dequantize_block_q_0_nc_cuda(const void * vx, dst_t * y,
+        const int64_t ne00, const int64_t ne01, const int64_t ne02, const int64_t ne03,
+        const int64_t s01, const int64_t s02, const int64_t s03, cudaStream_t stream) {
+    const int64_t nth_plane = ne01*(ne00/8);
+    if (ne00 % qk != 0 || nth_plane > int64_t(INT_MAX)) {
+        dequantize_block_cuda<qk, qr, dequantize_kernel>(vx, y, ne00, ne01, ne02, ne03, s01, s02, s03, stream);
+        return;
+    }
+    const int64_t ne0203 = ne02*ne03;
+    const uint3 ne02_fdv = init_fastdiv_values(ne02);
+    const dim3 num_blocks((nth_plane + CUDA_DEQUANTIZE_BLOCK_SIZE - 1) / CUDA_DEQUANTIZE_BLOCK_SIZE, (int)std::min(ne0203, (int64_t)65535), 1);
+    dequantize_block_q_0_nc<type><<<num_blocks, CUDA_DEQUANTIZE_BLOCK_SIZE, 0, stream>>>
+        (vx, y, ne00, ne01, ne0203, ne02_fdv, s01, s02, s03);
+}
