*.bin
models/

# Profiler output: summaries are committed under profiles/, raw reports are not
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite
profiles/raw/

# Agent receipts: logs stay local; ticket results are summarized in PRs
state/receipts/*.log
state/receipts/*.md
!state/receipts/.gitkeep

# Local overrides
CLAUDE.local.md
.worktrees/
third_party/*
!third_party/.gitkeep
!third_party/patches/
!third_party/patches-local/

# Local toolchain (docs/TOOLCHAIN.md)
.venv/
tools/
bench/models.txt
third_party/pr27997-work/

# Python bytecode
__pycache__/
*.pyc
third_party/pr27997-static/

# Raw benchmark logs stay local (gzipped copies / summaries are committed)
bench/results/**/*.err
bench/results/**/*.build.log
bench/results/**/build.log
bench/results/**/fa-test*.txt
bench/results/**/fa-support.txt
bench/results/**/fixbuild.log
