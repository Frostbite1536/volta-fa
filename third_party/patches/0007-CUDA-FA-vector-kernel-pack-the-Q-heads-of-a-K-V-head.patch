+        return (ncols1 == 1 || ic0 + jc/ncols2 < int(ne01.z)) && (ncols2 == 1 || zt_gqa*ncols2 + jc%ncols2 < gqa_ratio);
+    };
+    auto col_Q_offset = [&](const int jc) { return (jc/ncols2)*nb01 + (jc%ncols2)*nb02; };
 
     static_assert(D % (2*WARP_SIZE) == 0, "D not divisible by 2*WARP_SIZE == 64.");
     constexpr int nwarps = nthreads / WARP_SIZE;
     const int tid = WARP_SIZE*threadIdx.y + threadIdx.x;
     __builtin_assume(tid < nthreads);
 
-    constexpr int ne_KQ      = ncols*D;
+    // KQ holds the q8_1 Q (D per column) and later the softmax values (nthreads per column).
+    constexpr int ne_KQ      = ncols*(D > nthreads ? D : nthreads);
