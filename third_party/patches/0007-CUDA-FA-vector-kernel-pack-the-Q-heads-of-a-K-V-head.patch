     float logit_softcap;
     memcpy(&logit_softcap, (const float *) KQV->op_params + 2, sizeof(float));
 
+    // Quantized K, one token: put the Q heads that share a K/V head into one block so that K/V are read and
+    // dequantized once per 2 or 4 heads instead of once per Q head. 4 heads per block for GQA ratios that are a
+    // multiple of 4 and for 7 (padded to 8, the extra head masked), otherwise 2 (GQA 3 and 5 padded to 4 and 6).
+    // 8 heads per block were never faster than 4 on a V100, and GQA 2 is left unpacked (slower at 4K for D=256).
+    // Q is kept as q8_1 for quantized K, so the packed columns fit in registers; F16/BF16 K keep Q as floats.
+    if constexpr (type_K != GGML_TYPE_F16 && type_K != GGML_TYPE_BF16) {
